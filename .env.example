# ================================================================
# EMS LSTM Thermal Anomaly — Root Environment Variables
# Salin file ini menjadi .env dan sesuaikan nilainya
# ================================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ems_db
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=ems_password

# --- Backend Go ---
BACKEND_PORT=8080
BACKEND_HOST=localhost

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
VITE_SSE_URL=http://localhost:8080/api/v1/events

# --- Telegram (isi setelah bot dibuat) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
