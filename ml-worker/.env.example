# ================================================================
# ML Worker — Environment Variables
# ================================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ems_db
DB_USER=ems_user
DB_PASSWORD=ems_password

# Backend callback (untuk SSE dan trigger notifikasi)
BACKEND_URL=http://localhost:8080
ML_WORKER_API_TOKEN=dev-ml-worker-token-change-in-production

# ML Config
WINDOW_SIZE=30
HORIZON_MINUTES=5
SAMPLING_INTERVAL_SECONDS=60
MODEL_DIR=models/
SCALER_DIR=models/

# Training
EPOCHS=100
BATCH_SIZE=32
VALIDATION_SPLIT=0.1
EARLY_STOPPING_PATIENCE=10

# Logging
LOG_LEVEL=info
