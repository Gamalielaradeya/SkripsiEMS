# ================================================================
# Backend Go — Environment Variables
# Salin file ini menjadi .env
# ================================================================

# Server
SERVER_PORT=8080
SERVER_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ems_db
DB_USER=ems_user
DB_PASSWORD=ems_password
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ENABLED=false
TELEGRAM_COOLDOWN_MINUTES=5

# API Token for Gateway
GATEWAY_API_TOKEN=dev-token-change-in-production

# CORS (frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info
